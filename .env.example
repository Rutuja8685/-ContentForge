# ──────────────────────────────────────────────
# ContentForge – Environment Variables Template
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Google Gemini API
GOOGLE_API_KEY=your-gemini-api-key-here

# Database (SQLite default; swap for Postgres in production)
DATABASE_URL=sqlite:///./contentforge.db

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=ContentForge
APP_ENV=development
LOG_LEVEL=INFO

# Upload limits (bytes)
MAX_UPLOAD_SIZE=10485760

# CORS (comma-separated origins)
CORS_ORIGINS=*
